# Copy to .env and fill in. Never commit real values.
MOCK_LLM=1                    # 1 = offline mock (demo), 0 = real models
DISCORD_BOT_TOKEN=            # Discord bot token for src/bot.py + buffer DMs
DISCORD_DEFAULT_USER_ID=      # fallback Discord user id for buffer DMs
BUFFER_ALERT_INTERVAL_SECONDS=3600  # max 1 buffer alert per account per hour
OPENROUTER_API_KEY=           # frontier tier (kimi-k3 / glm-5.3 / claude)
OLLAMA_BASE_URL=http://localhost:11434
POSTGRES_URL=postgresql://copilot:copilot@postgres:5432/copilot
RULE_REGISTRY_DB_URL=         # defaults to POSTGRES_URL; in-memory SQLite if unset
REDIS_URL=redis://redis:6379/0
